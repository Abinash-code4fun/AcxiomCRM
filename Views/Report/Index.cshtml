@{
    ViewData["Title"] = "Reports & Analytics Center";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-bar-graph text-primary me-2"></i>Executive Reports & Export Center</h2>
        <p class="text-muted mb-0">Generate live data tables, inspect sales records, and stream CSV exports for offline reporting.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Customer Report Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-primary-subtle text-primary me-3">
                            <i class="bi bi-buildings fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Customer Accounts</h5>
                            <span class="text-muted small">Account Directory</span>
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Comprehensive account listings, primary contact methods, assigned sales executive, and associated deals count.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="ViewReport" asp-route-reportType="customer" class="btn btn-outline-primary btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i> View Live
                    </a>
                    <a asp-action="ExportCsv" asp-route-reportType="customer" class="btn btn-primary btn-sm">
                        <i class="bi bi-download me-1"></i> CSV
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Lead Report Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-info-subtle text-info me-3">
                            <i class="bi bi-funnel fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Lead Generation</h5>
                            <span class="text-muted small">Prospect Qualification</span>
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Detailed breakdown of all leads, source attribution channels, qualification priority, status, and owner assignments.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="ViewReport" asp-route-reportType="lead" class="btn btn-outline-info btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i> View Live
                    </a>
                    <a asp-action="ExportCsv" asp-route-reportType="lead" class="btn btn-info text-white btn-sm">
                        <i class="bi bi-download me-1"></i> CSV
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunity Pipeline Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-success-subtle text-success me-3">
                            <i class="bi bi-graph-up-arrow fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Pipeline & Forecasting</h5>
                            <span class="text-muted small">Revenue Projection</span>
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Complete deal pipeline across all stages, probability scoring, weighted revenue projections, and expected closing milestones.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="ViewReport" asp-route-reportType="opportunity" class="btn btn-outline-success btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i> View Live
                    </a>
                    <a asp-action="ExportCsv" asp-route-reportType="opportunity" class="btn btn-success btn-sm">
                        <i class="bi bi-download me-1"></i> CSV
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Activities & Follow-ups Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-warning-subtle text-warning me-3">
                            <i class="bi bi-calendar-check fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Activity & Touchpoints</h5>
                            <span class="text-muted small">Client Engagement</span>
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Log of planned and executed activities, calls, meetings, tasks, completion dates, and assignee performance.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="ViewReport" asp-route-reportType="followup" class="btn btn-outline-warning text-dark btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i> View Live
                    </a>
                    <a asp-action="ExportCsv" asp-route-reportType="followup" class="btn btn-warning text-dark btn-sm">
                        <i class="bi bi-download me-1"></i> CSV
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Lead Conversion Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-secondary-subtle text-secondary me-3">
                            <i class="bi bi-arrow-repeat fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Conversion Analysis</h5>
                            <span class="text-muted small">Efficiency Metrics</span>
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Audit of converted leads, created customer accounts, generated deals, conversion timestamps, and owning executives.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="ViewReport" asp-route-reportType="conversion" class="btn btn-outline-secondary btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i> View Live
                    </a>
                    <a asp-action="ExportCsv" asp-route-reportType="conversion" class="btn btn-secondary btn-sm">
                        <i class="bi bi-download me-1"></i> CSV
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- User Activity Audit Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-danger-subtle text-danger me-3">
                            <i class="bi bi-shield-check fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">User & Security Activity</h5>
                            <span class="text-muted small">System Operations</span>
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Detailed log of user actions, logins, status updates, deletions, and administrative changes with IP and UTC stamps.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="ViewReport" asp-route-reportType="useractivity" class="btn btn-outline-danger btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i> View Live
                    </a>
                    <a asp-action="ExportCsv" asp-route-reportType="useractivity" class="btn btn-danger btn-sm">
                        <i class="bi bi-download me-1"></i> CSV
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
