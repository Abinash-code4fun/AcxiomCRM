@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card auth-card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header auth-header text-center border-0 py-4">
                <div class="auth-brand-badge mb-2">
                    <span class="fs-3 fw-bold text-primary">Acxiom<span class="text-dark">CRM</span></span>
                </div>
                <h2 class="h5 card-title fw-bold text-dark mb-1">Create your CRM Account</h2>
                <p class="text-muted small mb-0">Join your team workspace and start managing pipelines</p>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="FullName" class="form-control form-control-lg rounded-3 fs-6" placeholder="e.g. Jane Doe" autocomplete="name" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Email" class="form-control form-control-lg rounded-3 fs-6" placeholder="jane@company.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Password" class="form-control form-control-lg rounded-3 fs-6" placeholder="••••••••" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg rounded-3 fs-6" placeholder="••••••••" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-text small text-muted">
                                Password must be at least 8 characters and include uppercase, lowercase, numbers, and symbols.
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold fs-6 shadow-sm py-2">
                        Complete Registration
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light border-0 py-3 text-center text-muted small">
                Already have an account? 
                <a asp-action="Login" class="text-primary text-decoration-none fw-semibold ms-1">Sign in here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
