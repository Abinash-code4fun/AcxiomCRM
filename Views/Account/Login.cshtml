@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="card auth-card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header auth-header text-center border-0 py-4">
                <div class="auth-brand-badge mb-2">
                    <span class="fs-3 fw-bold text-primary">Acxiom<span class="text-dark">CRM</span></span>
                </div>
                <h2 class="h5 card-title fw-bold text-dark mb-1">Welcome back</h2>
                <p class="text-muted small mb-0">Sign in to your CRM workspace</p>
            </div>
            <div class="card-body p-4 p-md-4 pt-2">
                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <input asp-for="Email" class="form-control form-control-lg rounded-3 fs-6" placeholder="name@company.com" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-0"></label>
                        </div>
                        <input asp-for="Password" class="form-control form-control-lg rounded-3 fs-6 mt-1" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold fs-6 shadow-sm py-2">
                        Sign In
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light border-0 py-3 text-center text-muted small">
                Don't have an account yet? 
                <a asp-action="Register" class="text-primary text-decoration-none fw-semibold ms-1">Register here</a>
            </div>
        </div>

        <div class="mt-4 p-3 rounded-3 bg-light border text-center small text-secondary">
            <span class="fw-semibold text-dark">Local Development Info:</span><br />
            Administrator credentials can be configured in <code>appsettings.Development.json</code> or seeded automatically upon migration.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
