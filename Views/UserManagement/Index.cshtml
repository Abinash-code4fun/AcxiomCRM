@model AcxiomCRM.Models.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>User & Role Administration</h2>
        <p class="text-muted mb-0">Manage CRM user access, assign organizational roles, and enforce account lockouts.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Add New User
        </a>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card crm-card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search by name or email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="roleFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Roles --</option>
                    <option value="@AppRoles.Admin" selected="@(Model.RoleFilter == AppRoles.Admin)">@AppRoles.Admin</option>
                    <option value="@AppRoles.Manager" selected="@(Model.RoleFilter == AppRoles.Manager)">@AppRoles.Manager</option>
                    <option value="@AppRoles.SalesExecutive" selected="@(Model.RoleFilter == AppRoles.SalesExecutive)">@AppRoles.SalesExecutive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.RoleFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card crm-card">
    <div class="table-responsive">
        <table class="table crm-table align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Lockout</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-2 bg-primary text-white fw-bold d-flex align-items-center justify-content-center rounded-circle" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                        @(user.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="fw-bold">@user.FullName</div>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge badge-role role-@user.Role.ToLowerInvariant()">@user.Role</span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger text-white">Locked Out</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Normal</span>
                                }
                            </td>
                            <td class="small text-muted">@user.CreatedAtUtc.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Edit Profile & Role">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-warning text-dark" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    @if (user.IsLockedOut)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Unlock this account?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Unlock Account">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No users found matching your search.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
