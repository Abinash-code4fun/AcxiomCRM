@model AcxiomCRM.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "CRM Executive Dashboard";
}

<!-- Dashboard Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">Executive Dashboard</h2>
            <span class="badge badge-role role-@Model.UserRole.ToLowerInvariant()">@Model.UserRole Scope</span>
        </div>
        <p class="text-muted mb-0">
            Welcome back, <strong>@Model.UserName</strong>. Real-time overview of business pipeline, leads, and upcoming activities.
        </p>
    </div>

    <!-- Timeframe Filter -->
    <div class="d-flex align-items-center gap-2">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label class="text-muted small fw-semibold text-nowrap">Timeframe:</label>
            <select name="dateRange" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="all" selected="@(Model.DateRange == "all")">All Time</option>
                <option value="today" selected="@(Model.DateRange == "today")">Today</option>
                <option value="week" selected="@(Model.DateRange == "week")">This Week</option>
                <option value="month" selected="@(Model.DateRange == "month")">This Month</option>
                <option value="quarter" selected="@(Model.DateRange == "quarter")">This Quarter</option>
                <option value="year" selected="@(Model.DateRange == "year")">This Year</option>
            </select>
        </form>
    </div>
</div>

<!-- Overdue Activities Banner -->
@if (Model.OverdueFollowUps.Any())
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>Action Required:</strong> You have <strong>@Model.OverdueFollowUps.Count</strong> overdue activity follow-ups requiring prompt attention.
            </div>
        </div>
        <a asp-controller="FollowUp" asp-action="Index" asp-route-status="Overdue" class="btn btn-outline-danger btn-sm">
            View Overdue Tasks
        </a>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card crm-stat-card border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Total Customers</div>
                        <div class="stat-value text-primary">@Model.Kpis.TotalCustomers</div>
                        <div class="text-muted small mt-1">Verified Accounts</div>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Leads / Open Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card crm-stat-card border-start border-4 border-info">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Active Leads</div>
                        <div class="stat-value text-info">@Model.Kpis.OpenLeads</div>
                        <div class="text-muted small mt-1">Total: @Model.Kpis.TotalLeads leads</div>
                    </div>
                    <div class="stat-icon bg-info-subtle text-info">
                        <i class="bi bi-funnel"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card crm-stat-card border-start border-4 border-warning">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Total Pipeline</div>
                        <div class="stat-value text-warning">@Model.Kpis.TotalPipeline.ToString("C0")</div>
                        <div class="text-muted small mt-1">
                            Weighted: <strong>@Model.Kpis.WeightedPipeline.ToString("C0")</strong>
                        </div>
                    </div>
                    <div class="stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Won Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card crm-stat-card border-start border-4 border-success">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Won Opportunities</div>
                        <div class="stat-value text-success">@Model.Kpis.WonOpportunities</div>
                        <div class="text-muted small mt-1">
                            Lost: @Model.Kpis.LostOpportunities deals
                        </div>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card crm-card p-3">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3">
                    <i class="bi bi-briefcase"></i>
                </div>
                <div>
                    <div class="text-muted small">Open Deals</div>
                    <div class="h5 fw-bold mb-0">@Model.Kpis.OpenOpportunities / @Model.Kpis.TotalOpportunities Total</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card crm-card p-3">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-info-subtle text-info me-3">
                    <i class="bi bi-calendar2-event"></i>
                </div>
                <div>
                    <div class="text-muted small">Pending Follow-Ups</div>
                    <div class="h5 fw-bold mb-0">@Model.Kpis.PendingFollowUps</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card crm-card p-3">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-danger-subtle text-danger me-3">
                    <i class="bi bi-alarm"></i>
                </div>
                <div>
                    <div class="text-muted small">Overdue Tasks</div>
                    <div class="h5 fw-bold text-danger mb-0">@Model.Kpis.OverdueFollowUps</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Opportunities by Stage (Bar) -->
    <div class="col-lg-6">
        <div class="card crm-card h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-bar-chart-steps text-primary me-2"></i>Opportunities by Stage</h5>
                <span class="badge bg-light text-muted border">Live Value</span>
            </div>
            <div class="card-body p-3">
                <div style="height: 300px; position: relative;">
                    <canvas id="stageChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Leads by Status (Doughnut) -->
    <div class="col-lg-6">
        <div class="card crm-card h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-pie-chart text-info me-2"></i>Leads by Status</h5>
                <span class="badge bg-light text-muted border">Distribution</span>
            </div>
            <div class="card-body p-3">
                <div style="height: 300px; position: relative;">
                    <canvas id="leadsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Pipeline Trend (Line) -->
    <div class="col-12">
        <div class="card crm-card">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-graph-up text-success me-2"></i>Monthly Pipeline Trend</h5>
                <span class="badge bg-light text-muted border">6 Month Rolling</span>
            </div>
            <div class="card-body p-3">
                <div style="height: 280px; position: relative;">
                    <canvas id="pipelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upcoming Follow-ups Feed -->
<div class="card crm-card mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Upcoming Scheduled Follow-Ups</h5>
        <a asp-controller="FollowUp" asp-action="Index" class="btn btn-outline-primary btn-sm">
            View All Activities
        </a>
    </div>
    <div class="table-responsive">
        <table class="table crm-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Scheduled</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related Record</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.UpcomingFollowUps.Any())
                {
                    @foreach (var f in Model.UpcomingFollowUps)
                    {
                        <tr>
                            <td class="text-nowrap font-monospace small">@f.ScheduledDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><span class="badge bg-light text-dark border">@f.Type</span></td>
                            <td class="fw-semibold">@f.Subject</td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none">
                                        <i class="bi bi-buildings me-1"></i>@f.Customer.Name
                                    </a>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Lead" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none">
                                        <i class="bi bi-funnel me-1"></i>@f.Lead.FullName
                                    </a>
                                }
                                else if (f.Opportunity != null)
                                {
                                    <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@f.OpportunityId" class="text-decoration-none">
                                        <i class="bi bi-briefcase me-1"></i>@f.Opportunity.Name
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@(f.AssignedTo?.FullName ?? "Unassigned")</td>
                            <td><span class="badge bg-primary-subtle text-primary">@f.Status</span></td>
                            <td class="text-end">
                                <a asp-controller="FollowUp" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-check fs-2 text-secondary opacity-50 d-block mb-1"></i>
                            No upcoming activities scheduled for this timeframe.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Stage Chart
            const stageCtx = document.getElementById('stageChart');
            if (stageCtx) {
                new Chart(stageCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.OpportunitiesByStage.Labels)),
                        datasets: [{
                            label: 'Pipeline Value ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.OpportunitiesByStage.Data)),
                            backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.OpportunitiesByStage.BackgroundColors)),
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { callback: v => '$' + Number(v).toLocaleString() }
                            }
                        }
                    }
                });
            }

            // Leads Chart
            const leadsCtx = document.getElementById('leadsChart');
            if (leadsCtx) {
                new Chart(leadsCtx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.LeadsByStatus.Labels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.LeadsByStatus.Data)),
                            backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.LeadsByStatus.BackgroundColors))
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }

            // Monthly Pipeline Trend Chart
            const pipeCtx = document.getElementById('pipelineChart');
            if (pipeCtx) {
                new Chart(pipeCtx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.MonthlyPipeline.Labels)),
                        datasets: [{
                            label: 'Monthly Pipeline Volume ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.MonthlyPipeline.Data)),
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.1)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 4,
                            pointBackgroundColor: '#2563eb'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { callback: v => '$' + Number(v).toLocaleString() }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
