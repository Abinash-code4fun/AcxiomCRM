<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM Enterprise</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcxiomCRM.styles.css" asp-append-version="true" />
</head>
<body class="bg-slate">
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark bg-dark-navy shadow-sm py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center fw-bold fs-4 text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge me-2"><i class="bi bi-shield-check"></i></span>Acxiom<span class="brand-accent">CRM</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-xl-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-75 px-3 d-flex align-items-center" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-75 px-3 d-flex align-items-center" asp-controller="Customer" asp-action="Index">
                                    <i class="bi bi-buildings me-1"></i> Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-75 px-3 d-flex align-items-center" asp-controller="Lead" asp-action="Index">
                                    <i class="bi bi-funnel me-1"></i> Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-75 px-3 d-flex align-items-center" asp-controller="Opportunity" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-75 px-3 d-flex align-items-center" asp-controller="FollowUp" asp-action="Index">
                                    <i class="bi bi-calendar-check me-1"></i> Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-75 px-3 d-flex align-items-center" asp-controller="Report" asp-action="Index">
                                    <i class="bi bi-file-earmark-bar-graph me-1"></i> Reports
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning px-3 d-flex align-items-center fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-wide-connected me-1"></i> Administration
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow border-0" aria-labelledby="adminDropdown">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="UserManagement" asp-action="Index">
                                                <i class="bi bi-people me-2"></i> User & Role Management
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="AuditLog" asp-action="Index">
                                                <i class="bi bi-journal-text me-2"></i> System Audit Logs
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 py-4 main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-sm-row justify-content-between align-items-center small gap-2">
            <div>
                &copy; @DateTime.UtcNow.Year - <strong class="text-dark">AcxiomCRM</strong> Enterprise Architecture &bull; All Rights Reserved.
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-shield-lock-fill me-1"></i> RBAC Enforced</span>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-database me-1"></i> SQL Server LocalDB</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
