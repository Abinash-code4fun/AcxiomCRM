@model AcxiomCRM.Models.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = $"Customer - {Model.Customer.Name}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">@Model.Customer.Name</h2>
            @if (Model.Customer.Status == CustomerStatus.Active)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
            }
        </div>
        <p class="text-muted mb-0">Customer ID: #@Model.Customer.Id &bull; Created @Model.Customer.CreatedAtUtc.ToString("MMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.Customer.Id" class="btn btn-outline-primary">
            <i class="bi bi-graph-up me-1"></i> Add Deal
        </a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.Customer.Id" class="btn btn-outline-success">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Customer.Id" class="btn btn-secondary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Customer.Id" method="post" onsubmit="return confirm('Are you sure you want to deactivate or remove this customer?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Contact Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold">Email Address</label>
                    <div><a href="mailto:@Model.Customer.Email" class="text-decoration-none fw-medium">@Model.Customer.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold">Phone Number</label>
                    <div class="fw-medium">@(Model.Customer.Phone ?? "Not provided")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold">Address</label>
                    <div class="text-secondary">@(Model.Customer.Address ?? "Not provided")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold">Assigned Executive</label>
                    <div>
                        <span class="badge bg-light text-dark border">
                            @(Model.Customer.AssignedTo?.FullName ?? Model.Customer.AssignedTo?.UserName ?? "Unassigned")
                        </span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Customer.Notes))
                {
                    <div>
                        <label class="text-muted small text-uppercase fw-semibold">Internal Notes</label>
                        <div class="p-2 bg-light rounded text-secondary small">@Model.Customer.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Associated Deals / Opportunities -->
        <div class="card crm-card mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>Associated Deals (@Model.Opportunities.Count)</h5>
                <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.Customer.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>
            <div class="table-responsive">
                <table class="table crm-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Deal Name</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Expected Close</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Opportunities.Any())
                        {
                            @foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@opp.Id" class="fw-bold text-decoration-none text-dark">
                                            @opp.Name
                                        </a>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@opp.Stage</span></td>
                                    <td class="fw-bold text-success">@opp.Amount.ToString("C")</td>
                                    <td>@opp.Probability%</td>
                                    <td class="text-muted small">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No deals currently linked to this customer.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Associated Follow-ups / Activities -->
        <div class="card crm-card">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-calendar-check text-info me-2"></i>Activities & Follow-Ups (@Model.FollowUps.Count)</h5>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.Customer.Id" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>
            <div class="table-responsive">
                <table class="table crm-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Scheduled Date</th>
                            <th>Assigned To</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            @foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td>@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.Type</span></td>
                                    <td class="small">@f.ScheduledDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small">@(f.AssignedTo?.FullName ?? f.AssignedTo?.UserName ?? "-")</td>
                                    <td>
                                        @if (f.Status == FollowUpStatus.Completed)
                                        {
                                            <span class="badge bg-success-subtle text-success">Completed</span>
                                        }
                                        else if (f.Status == FollowUpStatus.Planned && f.ScheduledDate < DateTime.UtcNow)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary">@f.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No activities logged yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
