@model List<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "System Audit Trail";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Security & Audit Trail</h2>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Admin Only</span>
        </div>
        <p class="text-muted mb-0">Immutable compliance log of all system changes, entity creations, edits, deletions, and user conversions.</p>
    </div>
</div>

<!-- Filters Bar -->
<div class="card crm-card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="module" value="@ViewBag.Module" class="form-control form-control-sm" placeholder="Module (e.g. Lead, Customer...)" />
            </div>
            <div class="col-md-3">
                <input type="text" name="actionName" value="@ViewBag.ActionName" class="form-control form-control-sm" placeholder="Action (e.g. Create, Convert...)" />
            </div>
            <div class="col-md-2">
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" placeholder="From Date" />
            </div>
            <div class="col-md-2">
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" placeholder="To Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table -->
<div class="card crm-card">
    <div class="table-responsive">
        <table class="table crm-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record ID</th>
                    <th>IP Address</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-nowrap small font-monospace">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace small">
                                    @(log.UserName ?? log.UserId ?? "System")
                                </span>
                            </td>
                            <td>
                                @if (log.Action.Contains("Delete", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger-subtle text-danger">@log.Action</span>
                                }
                                else if (log.Action.Contains("Convert", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success-subtle text-success">@log.Action</span>
                                }
                                else if (log.Action.Contains("Create", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-primary-subtle text-primary">@log.Action</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">@log.Action</span>
                                }
                            </td>
                            <td class="fw-semibold">@log.Module</td>
                            <td class="small font-monospace text-muted">@log.EntityId</td>
                            <td class="small text-muted font-monospace">@(log.IpAddress ?? "-")</td>
                            <td class="small">
                                <span class="text-secondary text-truncate d-inline-block" style="max-width: 320px;" title="@log.Details">
                                    @log.Details
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-check fs-1 text-secondary opacity-50 d-block mb-2"></i>
                            No audit trail records found matching criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
