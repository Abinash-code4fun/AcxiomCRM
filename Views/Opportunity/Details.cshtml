@model AcxiomCRM.Models.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = $"Deal - {Model.Opportunity.Name}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">@Model.Opportunity.Name</h2>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">@Model.Opportunity.Stage</span>
        </div>
        <p class="text-muted mb-0">Deal ID: #@Model.Opportunity.Id &bull; Created @Model.Opportunity.CreatedAtUtc.ToString("MMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FollowUp" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-outline-success">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Opportunity.Id" class="btn btn-secondary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Opportunity.Id" method="post" onsubmit="return confirm('Are you sure you want to deactivate or remove this deal?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </div>
</div>

<!-- Opportunity Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="crm-stat-card">
            <div class="stat-lbl">Deal Amount</div>
            <div class="stat-val text-primary">@Model.Opportunity.Amount.ToString("C0")</div>
            <div class="small text-muted mt-1">Full contract value</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="crm-stat-card">
            <div class="stat-lbl">Win Probability</div>
            <div class="stat-val text-info">@Model.Opportunity.Probability%</div>
            <div class="small text-muted mt-1">Expected win likelihood</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="crm-stat-card">
            <div class="stat-lbl">Weighted Value</div>
            <div class="stat-val text-success">@Model.Opportunity.WeightedValue.ToString("C0")</div>
            <div class="small text-muted mt-1">Probability-weighted revenue</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="crm-stat-card">
            <div class="stat-lbl">Expected Close</div>
            <div class="stat-val text-dark fs-4">@Model.Opportunity.ExpectedCloseDate.ToString("MMM dd, yyyy")</div>
            <div class="small text-muted mt-1">Projected signing target</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card crm-card h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Account & Deal Specs</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold">Customer Account</label>
                    <div>
                        @if (Model.Opportunity.Customer != null)
                        {
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.Opportunity.Customer.Id" class="fw-bold fs-6 text-decoration-none">
                                @Model.Opportunity.Customer.Name
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Unlinked</span>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold">Deal Owner</label>
                    <div>
                        <span class="badge bg-light text-dark border">
                            @(Model.Opportunity.Owner?.FullName ?? Model.Opportunity.Owner?.UserName ?? "Unassigned")
                        </span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-semibold">Source Campaign</label>
                    <div>@(Model.Opportunity.Source ?? "Direct engagement")</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Opportunity.Notes))
                {
                    <div>
                        <label class="text-muted small text-uppercase fw-semibold">Strategic Notes</label>
                        <div class="p-2 bg-light rounded text-secondary small">@Model.Opportunity.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card crm-card">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-calendar-check text-info me-2"></i>Linked Activities (@Model.FollowUps.Count)</h5>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>
            <div class="table-responsive">
                <table class="table crm-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Scheduled Date</th>
                            <th>Assigned To</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            @foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td>@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.Type</span></td>
                                    <td class="small">@f.ScheduledDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small">@(f.AssignedTo?.FullName ?? f.AssignedTo?.UserName ?? "-")</td>
                                    <td>
                                        @if (f.Status == FollowUpStatus.Completed)
                                        {
                                            <span class="badge bg-success-subtle text-success">Completed</span>
                                        }
                                        else if (f.Status == FollowUpStatus.Planned && f.ScheduledDate < DateTime.UtcNow)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary">@f.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No activities recorded for this deal yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
