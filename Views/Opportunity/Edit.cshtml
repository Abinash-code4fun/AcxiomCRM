@model AcxiomCRM.Models.ViewModels.OpportunityFormViewModel
@{
    ViewData["Title"] = $"Edit Deal - {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card crm-card">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Opportunity / Deal</h4>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Details
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                                <option value="">-- Select Customer Account --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OwnerId" class="form-label"></label>
                            <select asp-for="OwnerId" class="form-select" asp-items="Model.Owners">
                                <option value="">-- Select Deal Owner --</option>
                            </select>
                            <span asp-validation-for="OwnerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label"></label>
                            <select asp-for="Stage" class="form-select">
                                @foreach (var s in Enum.GetValues<OpportunityStage>())
                                {
                                    <option value="@s" selected="@(Model.Stage == s)">@s</option>
                                }
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label"></label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label"></label>
                            <input asp-for="Source" class="form-control" />
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
