@model AcxiomCRM.Models.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-funnel text-primary me-2"></i>Leads</h2>
        <p class="text-muted mb-0">Track prospect discovery, qualification, status workflow, and conversions.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> New Lead
        </a>
    </div>
</div>

<div class="card crm-card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search by name, email, company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Statuses --</option>
                    @foreach (var s in Enum.GetValues<LeadStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="priority" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Priorities --</option>
                    @foreach (var p in Enum.GetValues<LeadPriority>())
                    {
                        <option value="@p" selected="@(Model.Priority == p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(Model.Search) || Model.Status.HasValue || Model.Priority.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card crm-card">
    <div class="table-responsive">
        <table class="table crm-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Lead Name</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leads.Any())
                {
                    @foreach (var l in Model.Leads)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@l.Id" class="fw-bold text-decoration-none text-dark">
                                    @l.FullName
                                </a>
                            </td>
                            <td><a href="mailto:@l.Email" class="text-secondary text-decoration-none">@l.Email</a></td>
                            <td>@(l.Company ?? "-")</td>
                            <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                            <td>
                                @if (l.Status == LeadStatus.Converted)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Converted</span>
                                }
                                else if (l.Status == LeadStatus.Lost)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Lost</span>
                                }
                                else if (l.Status == LeadStatus.Qualified)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Qualified</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@l.Status</span>
                                }
                            </td>
                            <td>
                                @if (l.Priority == LeadPriority.High)
                                {
                                    <span class="badge bg-danger-subtle text-danger">High</span>
                                }
                                else if (l.Priority == LeadPriority.Medium)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Low</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(l.AssignedTo?.FullName ?? l.AssignedTo?.UserName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (l.Status != LeadStatus.Converted)
                                    {
                                        <a asp-action="Convert" asp-route-id="@l.Id" class="btn btn-outline-success" title="Convert to Customer">
                                            <i class="bi bi-arrow-repeat"></i> Convert
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@l.Id" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No lead records found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Showing page @Model.Page of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
