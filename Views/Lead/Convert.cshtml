@model AcxiomCRM.Models.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = $"Convert Lead - {Model.LeadName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card crm-card">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0 text-success"><i class="bi bi-arrow-repeat me-2"></i>Convert Lead to Customer</h4>
                    <span class="text-muted small">Promote qualified prospect into an active Customer Account and initiate an optional Deal.</span>
                </div>
                <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Lead
                </a>
            </div>
            <div class="card-body p-4">
                <!-- Prospect Information Summary -->
                <div class="alert alert-light border mb-4">
                    <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-info-circle me-1"></i> Lead Information</h6>
                    <div class="row g-2 small">
                        <div class="col-sm-4"><span class="text-muted">Lead Name:</span> <strong>@Model.LeadName</strong></div>
                        <div class="col-sm-4"><span class="text-muted">Email:</span> <strong>@Model.LeadEmail</strong></div>
                        <div class="col-sm-4"><span class="text-muted">Company:</span> <strong>@(Model.LeadCompany ?? "N/A")</strong></div>
                    </div>
                </div>

                <form asp-action="Convert" asp-route-id="@Model.LeadId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="LeadEmail" />
                    <input type="hidden" asp-for="LeadCompany" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <!-- Create Opportunity Toggle Section -->
                    <div class="card mb-4 border bg-light">
                        <div class="card-body">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="CreateOpportunity" id="createOppToggle" onchange="toggleOppFields()" />
                                <label class="form-check-label fw-bold" for="createOppToggle">Also create an initial Sales Opportunity / Deal</label>
                            </div>

                            <div id="oppFieldsContainer">
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label asp-for="OpportunityName" class="form-label"></label>
                                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise License - Q4" />
                                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="OpportunityAmount" class="form-label"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="ExpectedCloseDate" class="form-label"></label>
                                        <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-12">
                                        <label asp-for="Notes" class="form-label"></label>
                                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Initial discussion notes or requirements..."></textarea>
                                        <span asp-validation-for="Notes" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Complete Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleOppFields() {
            var isChecked = document.getElementById('createOppToggle').checked;
            document.getElementById('oppFieldsContainer').style.display = isChecked ? 'block' : 'none';
        }
        document.addEventListener('DOMContentLoaded', toggleOppFields);
    </script>
}
