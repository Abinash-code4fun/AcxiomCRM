@model AcxiomCRM.Models.ViewModels.FollowUpListViewModel
@{
    ViewData["Title"] = "Activities & Follow-Ups";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-check text-primary me-2"></i>Activities & Follow-Ups</h2>
        <p class="text-muted mb-0">Schedule meetings, track client touchpoints, log calls, and close pending tasks.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Schedule Activity
        </a>
    </div>
</div>

<!-- Overdue Activities Warning Section -->
@if (Model.Overdue.Any())
{
    <div class="card border-danger mb-4 shadow-sm">
        <div class="card-header bg-danger text-white py-2 d-flex align-items-center justify-content-between">
            <div class="fw-bold"><i class="bi bi-exclamation-octagon-fill me-2"></i>Overdue Activities Requiring Action (@Model.Overdue.Count)</div>
            <span class="badge bg-white text-danger fw-bold">Urgent</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Target (Customer / Lead / Deal)</th>
                        <th>Due Date</th>
                        <th>Assigned To</th>
                        <th class="text-end">Immediate Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Overdue)
                    {
                        var targetName = o.Customer != null ? $"Customer: {o.Customer.Name}" :
                                         (o.Lead != null ? $"Lead: {o.Lead.FullName}" :
                                         (o.Opportunity != null ? $"Deal: {o.Opportunity.Name}" : "None"));
                        <tr>
                            <td class="fw-bold text-danger">@o.Subject</td>
                            <td><span class="badge bg-light text-dark border">@o.Type</span></td>
                            <td>@targetName</td>
                            <td class="text-danger fw-semibold">@o.ScheduledDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(o.AssignedTo?.FullName ?? o.AssignedTo?.UserName ?? "-")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#completeModal-@o.Id">
                                    <i class="bi bi-check-lg"></i> Complete
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@o.Id">
                                    <i class="bi bi-clock-history"></i> Reschedule
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Filter Bar -->
<div class="card crm-card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Statuses --</option>
                    @foreach (var s in Enum.GetValues<FollowUpStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <select name="type" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Activity Types --</option>
                    @foreach (var t in Enum.GetValues<FollowUpType>())
                    {
                        <option value="@t" selected="@(Model.Type == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                @if (Model.Status.HasValue || Model.Type.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Main Activities Table -->
<div class="card crm-card">
    <div class="table-responsive">
        <table class="table crm-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Associated With</th>
                    <th>Scheduled Date</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FollowUps.Any())
                {
                    @foreach (var f in Model.FollowUps)
                    {
                        var assocDesc = f.Customer != null ? $"Customer: {f.Customer.Name}" :
                                        (f.Lead != null ? $"Lead: {f.Lead.FullName}" :
                                        (f.Opportunity != null ? $"Deal: {f.Opportunity.Name}" : "-"));

                        <tr>
                            <td class="fw-bold">@f.Subject</td>
                            <td><span class="badge bg-light text-dark border">@f.Type</span></td>
                            <td class="small">@assocDesc</td>
                            <td class="small @(f.Status == FollowUpStatus.Planned && f.ScheduledDate < DateTime.UtcNow ? "text-danger fw-bold" : "")">
                                @f.ScheduledDate.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td class="small">
                                <span class="badge bg-light text-dark border">
                                    @(f.AssignedTo?.FullName ?? f.AssignedTo?.UserName ?? "Unassigned")
                                </span>
                            </td>
                            <td>
                                @if (f.Status == FollowUpStatus.Completed)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check me-1"></i>Completed</span>
                                }
                                else if (f.Status == FollowUpStatus.Cancelled)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancelled</span>
                                }
                                else if (f.ScheduledDate < DateTime.UtcNow)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Planned</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (f.Status == FollowUpStatus.Planned)
                                    {
                                        <button type="button" class="btn btn-outline-success" title="Mark Completed" data-bs-toggle="modal" data-bs-target="#completeModal-@f.Id">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-warning text-dark" title="Reschedule" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.Id">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                    }
                                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>

                                <!-- Complete Modal -->
                                <div class="modal fade text-start" id="completeModal-@f.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="MarkCompleted" asp-route-id="@f.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-check2-circle text-success me-2"></i>Complete Activity</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Are you sure you want to mark <strong>@f.Subject</strong> as completed?</p>
                                                    <div class="mb-3">
                                                        <label class="form-label">Completion Notes / Outcome</label>
                                                        <textarea name="notes" class="form-control" rows="3" placeholder="Discussed product features, agreed to send proposal..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success">Mark Completed</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade text-start" id="rescheduleModal-@f.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Reschedule" asp-route-id="@f.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-calendar2-range text-warning me-2"></i>Reschedule Activity</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label">New Date & Time</label>
                                                        <input type="datetime-local" name="newDate" class="form-control" value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddTHH:mm")" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Reason / Notes</label>
                                                        <textarea name="notes" class="form-control" rows="2" placeholder="Client requested later time..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-warning text-dark">Save Reschedule</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No activities found matching criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Showing page @Model.Page of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@Model.Status" asp-route-type="@Model.Type">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
